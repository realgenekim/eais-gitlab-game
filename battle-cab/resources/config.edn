{;; ===== Tick & Timing =====
 :tick-ms              250    ;; ms per tick (250 = 4 ticks/sec)
 :game-duration-ticks  99999  ;; effectively infinite for dev (~7 hours at 250ms)

 ;; ===== Players =====
 :max-players          8
 :visibility-radius    8      ;; bigger vision so bots see each other sooner
 :respawn-ticks        6      ;; fast respawn, keep the action going

 ;; ===== Combat =====
 :shoot-range          20
 :shoot-damage         50     ;; hits hurt more — faster kills, more exciting
 :kill-bonus           150    ;; points for killing another player
 :max-ammo             10
 :ammo-regen-ticks     5      ;; ticks between ammo regen

 ;; ===== Passengers =====
 :max-passengers       6

 ;; ===== Battle Royale Shrink =====
 :shrink-start         100    ;; shrink starts at tick 100 (~25 sec) — forces bots together fast
 :shrink-interval      80     ;; rings close every 20 seconds
 :shrink-warn-ticks    10     ;; fire warning before shrink

 ;; ===== Lightning =====
 :lightning-chance      0.008  ;; probability per tick (~0.8%)
 :lightning-min-radius  2
 :lightning-max-radius  4
 :lightning-grace-ticks 20     ;; no strikes before this tick
 :crater-fire-ticks    10     ;; how long craters burn after strike

 ;; ===== Enemies =====
 :enemy-grace-ticks    4      ;; first wave at tick 4 (~1 second)
 :wave-interval        24     ;; waves every 6 seconds (was 10)
 }
